# LINE Bot 憑證(必填)— 請用 LINE Developers Console 重新產生的新 token
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Anthropic API(自然語言指令解析用,必填)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# 推播對象
# 一般情況留空:bot 會在使用者「加好友(follow)」時自動記住對方 userId 當推播對象。
# 也可手動指定:LINE_TARGET_ID=Uxxxxxxxx
LINE_TARGET_ID=
# 設為 true 改用 broadcast(推給所有好友),預設 false(push 給 LINE_TARGET_ID)
LINE_USE_BROADCAST=false

# 排程(node-cron 語法,時區由 TZ 決定)
TZ=Asia/Taipei
# 每日提醒:預設每天 09:00(早班,沒團時會送「已處理完」)
CRON_DAILY=0 9 * * *
# 每日提醒:預設每天 18:00(晚班,再 nudge 未打勾的團;全處理完則安靜不發)
CRON_DAILY_PM=0 18 * * *
# 每月月結:預設每月 1 號 09:00
CRON_MONTHLY=0 9 1 * *

# 提醒視窗(天)。預設 7,對齊舊腳本 isWithinSevenDays
REMINDER_WINDOW_DAYS=7

# 伺服器
PORT=3000

# 後台管理站台(/admin)的存取密碼。設定後才會啟用後台 API;
# 同時也是 /admin/run-daily、/admin/run-monthly 的 token。請用夠長的隨機字串。
ADMIN_TOKEN=

# 資料庫(Railway 持久卷請設 /app/data/bot.db)
DB_PATH=./data/bot.db

# 預設租戶
DEFAULT_TENANT=default

# 功能白名單(逗號分隔的 conversation id,例:群組 Cxxxx)。
# 只有白名單內的會話啟用所有功能、才會收到提醒。也可用 CLI 管理:
#   node src/allowlist.js seen        看 bot 最近見過的會話 ID
#   node src/allowlist.js add <id>    加入白名單
ALLOWLIST=
